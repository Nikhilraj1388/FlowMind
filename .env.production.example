# ═══════════════════════════════════════════════════════════════════════════════
# FlowMind — Production Environment Variables
# Copy this file to .env.production and fill in the values
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database (Railway PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://flowmind:CHANGE_ME@your-railway-postgres.railway.app:5432/flowmind_prod
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis (Railway Redis) ─────────────────────────────────────────────────────
REDIS_URL=redis://default:CHANGE_ME@your-railway-redis.railway.app:6379

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_live_CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# Clerk route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
NEXT_PUBLIC_API_URL=https://your-api.railway.app/api/v1
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ── Sentry Error Tracking (optional) ─────────────────────────────────────────
# SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
# NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
